<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build against an ArcPak.Export build folder: dotnet build -p:ArcPakBuild=<folder> -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Reference Include="CUE4Parse.Arc"><HintPath>$(ArcPakBuild)/CUE4Parse.Arc.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ArcPakBuild)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
