<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefineConstants>$(DefineConstants);ARC_ONLY</DefineConstants>
    <RootNamespace>CUE4Parse_Conversion</RootNamespace>
    <AssemblyName>CUE4Parse.Conversion.Arc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssetRipper.TextureDecoder" />
    <PackageReference Include="SharpGLTF.Core" />
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CUE4Parse.Arc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(Cue4ParseRoot)\CUE4Parse-Conversion\**\*.cs"
             Exclude="$(Cue4ParseRoot)\CUE4Parse-Conversion\obj\**\*.cs;
                      $(Cue4ParseRoot)\CUE4Parse-Conversion\bin\**\*.cs;
                      $(Cue4ParseRoot)\CUE4Parse-Conversion\Sounds\**\*.cs" />
  </ItemGroup>
  <!-- ArcPakPng=FastPng: ArcPak-owned TextureEncoder (FastPng PNG path) replaces the FModel-Vibe copy. -->
  <ItemGroup Condition="'$(ArcPakPng)' != 'Fpng'">
    <Compile Remove="$(Cue4ParseRoot)\CUE4Parse-Conversion\Textures\TextureEncoder.cs" />
    <Compile Include="ConversionOverrides\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(Cue4ParseRoot)\CUE4Parse-Conversion\Resources\Detex.dll">
      <LogicalName>CUE4Parse_Conversion.Resources.Detex.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(Cue4ParseRoot)\CUE4Parse-Conversion\Resources\tegra_swizzle_x64.dll">
      <LogicalName>CUE4Parse_Conversion.Resources.tegra_swizzle_x64.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(Cue4ParseRoot)\CUE4Parse-Conversion\Resources\crunch.dll">
      <LogicalName>CUE4Parse_Conversion.Resources.crunch.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
