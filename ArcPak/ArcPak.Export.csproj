<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArcPak.Export</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Trim warnings come from Newtonsoft reflection paths (IL2026). Suppress only that code here. -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimitPercent" Value="50" />
  </ItemGroup>

  <!-- Drop native debugging helpers from self-contained publish output. The runtime never loads them. -->
  <Target Name="ArcPakPruneDebugRuntime" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'createdump.exe' Or '%(Filename)%(Extension)' == 'mscordbi.dll' Or '%(Filename)%(Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll' Or $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^mscordaccore'))" />
    </ItemGroup>
  </Target>

  <!-- ArcPakPng=Fpng: ship native fpng.dll next to the exe (FpngEncoder loads it; Skia fallback when absent). -->
  <ItemGroup Condition="'$(ArcPakPng)' == 'Fpng' And Exists('$(FpngDllPath)')">
    <None Include="$(FpngDllPath)" Link="fpng.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="ConversionOverrides/**/*.cs" />
    <InternalsVisibleTo Include="ArcPak.MapExport.Tests" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapTraversalObject.cs" Link="MapTraversal/MapTraversalObject.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapPlacementExtractor.cs" Link="MapTraversal/MapPlacementExtractor.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapPlacementExtractorOptions.cs" Link="MapTraversal/MapPlacementExtractorOptions.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapPlacementExtractionResult.cs" Link="MapTraversal/MapPlacementExtractionResult.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapPlacementMetrics.cs" Link="MapTraversal/MapPlacementMetrics.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapPlacementSplineBakeJob.cs" Link="MapTraversal/MapPlacementSplineBakeJob.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapPlacementSplineNotes.cs" Link="MapTraversal/MapPlacementSplineNotes.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapTransformResolver.cs" Link="MapTraversal/MapTransformResolver.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Exporters/MapPlacement/MapGameplayExporter.cs" Link="MapTraversal/MapGameplayExporter.cs" />
    <Compile Include="../../FModel-Vibe/FModel/Views/Snooper/MapPlacement/MapPlacementRecord.cs" Link="MapTraversal/MapPlacementRecord.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CUE4Parse-Conversion.Arc.csproj" />
    <ProjectReference Include="CUE4Parse.Arc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
</Project>
